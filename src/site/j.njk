<style>
  /* The panel's own dusk scheme, truncated the way RGB565 truncates —
     so these are the colours the glass actually shows, not approximations. */
  :root {
    --sky-1: #282848;
    --sky-2: #683c68;
    --sky-3: #b86060;
    --sky-4: #e89458;
    --ink: #f8ecd0;
    --rock: #383038;
    --sand: #705850;
    --sea: #383458;
    --measure: 34rem;
    --pixel: 'Silkscreen', 'Courier New', monospace;
    --body: 'Fraunces', Georgia, 'Times New Roman', serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--sky-1);
    color: var(--ink);
    font-family: var(--body);
    font-optical-sizing: auto;
    font-size: 1.0625rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  /* Four hard bands, the way the device paints its sky. No gradient. */
  .sky {
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .sky i:nth-child(1) {
    background: var(--sky-1);
  }
  .sky i:nth-child(2) {
    background: var(--sky-2);
  }
  .sky i:nth-child(3) {
    background: var(--sky-3);
  }
  .sky i:nth-child(4) {
    background: var(--sky-4);
  }

  .hero {
    position: relative;
    isolation: isolate;
  }
  .shell {
    max-width: 62rem;
    margin: 0 auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }
  .page {
    padding-bottom: 6rem;
  }

  /* ── the greeting ─────────────────────────────────────────────── */
  header {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: 1fr;
    align-items: center;
    min-height: min(58vh, 30rem);
    padding-block: clamp(2.5rem, 8vh, 5rem);
  }
  @media (min-width: 46rem) {
    header {
      grid-template-columns: 1fr auto;
    }
  }

  .eyebrow {
    font-family: var(--pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(248, 236, 208, 0.72);
    margin: 0 0 1.25rem;
  }

  h1 {
    font-family: var(--pixel);
    font-weight: 700;
    font-size: clamp(1.75rem, 7.5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink);
    text-wrap: balance;
  }
  h1 em {
    display: block;
    font-style: normal;
    color: var(--sky-4);
  }

  .standfirst {
    max-width: 26rem;
    margin: 1.5rem 0 0;
    font-size: 1.125rem;
    color: rgba(248, 236, 208, 0.86);
  }

  /* ── a panel, as the object itself ────────────────────────────── */
  .device {
    --scale: 8;
    justify-self: center;
    padding: 0.75rem;
    background: var(--rock);
    border-radius: 0.5rem;
    box-shadow:
      0 1px 0 rgba(248, 236, 208, 0.14) inset,
      0 1.5rem 3rem rgba(20, 16, 34, 0.45);
  }
  .device .glass {
    width: calc(21px * var(--scale) / 2);
    background: var(--sea);
    border-radius: 0.125rem;
  }
  @media (min-width: 46rem) {
    .device {
      --scale: 12;
    }
  }

  .glass {
    display: block;
    overflow: hidden;
    aspect-ratio: 21 / 25;
    line-height: 0;
  }
  .glass svg {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  /* ── the letter ───────────────────────────────────────────────── */
  .letter {
    max-width: var(--measure);
    margin: clamp(3rem, 10vh, 6rem) 0 0;
  }
  .letter p {
    margin: 0 0 1.15em;
