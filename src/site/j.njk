  footer p {
    margin: 0 0 0.9em;
  }
  footer b {
    font-family: var(--pixel);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--sand);
    display: block;
    margin-bottom: 0.6rem;
  }

  /* The animations live in shadow roots, which this stylesheet cannot reach —
     a `@media (prefers-reduced-motion)` rule here looks like it handles motion
