<section class="hero">
  <div class="sky" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <header class="shell">
    <div>
      <p class="eyebrow">23 September</p>
      <h1>Happy birthday,<em>Jamie</em></h1>
      <p class="standfirst">
        Someone built you a crab. He lives on your desk and he has opinions
        about what Claude is doing.
      </p>
    </div>
    <div class="device"><div class="glass" data-clip="birthday"></div></div>
