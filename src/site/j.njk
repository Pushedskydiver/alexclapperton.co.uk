  }
  .next a:hover,
  .next a:focus-visible {
    color: var(--ink);
  }
  .next span {
    font-size: 0.9375rem;
    color: rgba(248, 236, 208, 0.66);
  }

  /* ── the gallery ──────────────────────────────────────────────── */
  .gallery {
    margin-top: clamp(4rem, 12vh, 7rem);
  }
  h2 {
    font-family: var(--pixel);
    font-size: clamp(1.0625rem, 2.6vw, 1.375rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    margin: 0 0 0.6rem;
