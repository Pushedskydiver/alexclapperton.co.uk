    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }
  .next a {
    font-family: var(--pixel);
    font-size: 0.9375rem;
    color: var(--sky-4);
    text-decoration: none;
    border-bottom: 2px solid currentColor;
