  .gallery > p {
    max-width: var(--measure);
    margin: 0 0 clamp(2rem, 5vh, 3rem);
    color: rgba(248, 236, 208, 0.78);
  }

  .grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
  }

  .cell {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .cell .glass {
    background: var(--sea);
    border-radius: 0.25rem;
    box-shadow: 0 0 0 1px rgba(248, 236, 208, 0.09);
  }
  figcaption {
    display: flex;
    flex-direction: column;
